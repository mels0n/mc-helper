# Example nginx server block for the mc-helper admin page. Copy it, then replace every
# placeholder in angle brackets and the example values below with your own.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name <admin-host>;

    ssl_certificate     <path-to-certificate>;
    ssl_certificate_key <path-to-private-key>;

    # Only these networks may open the page. The ranges below are reserved for documentation
    # (RFC 5737): replace them with your own client networks, and keep the page away from the
    # internet. Never allow a Docker address pool: on Swarm, publish the proxy's ports with
    # mode=host (or use the PROXY protocol or the real-ip module) so that $remote_addr is the
    # real client address. Otherwise the allow list and the app's login lockout both see the
    # same internal address for every client and stop working.
    allow 192.0.2.0/24;
    allow 198.51.100.0/24;
    deny all;

    client_max_body_size 1k;

    # Resolve the app's name when a request arrives, not only at startup, so the proxy keeps
    # working when the app is restarted and gets a new address. 127.0.0.11 is Docker's
    # embedded DNS.
    resolver 127.0.0.11 valid=10s;

    location / {
        # <app-service> is the name the app answers to on the shared network: `mc-helper` in
        # the documented commands.
        set $mc_upstream http://<app-service>:8000;
        proxy_pass $mc_upstream;
        proxy_set_header Host $host;
        # Replace, never append. The app believes this header only when the connection comes
        # from an address in TRUSTED_PROXIES, and uses the client address in it for the login
        # lockout.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The app waits up to 30 seconds for the server to answer an action.
        proxy_read_timeout 45s;
    }
}
